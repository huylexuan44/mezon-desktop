# Rust build artifacts
target/
# Alternate CARGO_TARGET_DIR checkouts (review/bench worktrees) — multi-GB each
target-*/

# macOS
.DS_Store

# Editor
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo

# Local environment (secrets)
.env
.env.local
.session.json
.mcp-sessions.json

# Local agent tooling (Claude Code / Cursor) — keep personal cruft ignored,
# but commit shared fmt/vendor guardrails so agents cannot drift.
# Note: must ignore contents (`dir/*`), not the dir itself, or negation cannot
# re-include nested paths.
.codebase-memory/
.agents/
.claude/*
!.claude/rules/
!.claude/rules/**
!.claude/skills/
!.claude/skills/**
!.claude/settings.json
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.claudeignore
.cursorignore

# Local project docs / tooling scripts (personal, not committed)
# AGENTS.md is tracked (agent formatting entrypoint). CLAUDE.md stays local
# unless force-added — keep personal notes out of git by default.
CACHE_FLOW.md
CLAUDE.md
MASTER_CHECKLIST.md
TEAM_SETUP.md
install-team.sh
profile.json.gz
scripts/*
!scripts/linux-deps
!scripts/webrtc/
!scripts/build-deb.sh
!scripts/gen_theme_surfaces.py
!scripts/make-update-feed.sh
!scripts/make-update-manifest.sh
!scripts/install-linux.sh
!scripts/install-windows.ps1
!scripts/perf-monitor-macos.sh
!scripts/perf-monitor-windows.ps1
!scripts/perf-compare.sh
# Must be committed: the fmt scope lives here, and both the pre-commit hook and
# the CI Format job execute it. If this is ignored, CI fails with "No such file".
!scripts/fmt.sh

# Must be committed: `just run`/`watch`/`tracy`/`release` source it under
# `set -euo pipefail`. It holds no secrets — it only sources .env when present.
!scripts/load-env.sh

perf-report*.json
