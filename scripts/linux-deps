#!/usr/bin/env bash
set -euo pipefail

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
    SUDO="sudo"
fi

$SUDO apt-get update
$SUDO apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    cmake \
    clang \
    libssl-dev \
    libzstd-dev \
    libasound2-dev \
    libfontconfig-dev \
    libfreetype-dev \
    libwayland-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libxcb1-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libvulkan-dev \
    mesa-vulkan-drivers \
    libgtk-3-dev \
    libxdo-dev \
    libayatana-appindicator3-dev \
    protobuf-compiler
